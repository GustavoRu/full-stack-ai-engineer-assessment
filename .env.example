# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docqa
DB_USER=docqa
DB_PASSWORD=docqa

# Auth: any string of 32 or more characters
JWT_SECRET=local-dev-secret-change-me-32-chars-min
JWT_EXPIRES_IN_SECONDS=3600

# LLM provider: "gemini" needs GEMINI_API_KEY, "mock" runs offline with fake answers
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
PROMPT_VERSION=qa-v1

# Limits
MAX_UPLOAD_BYTES=5242880
MAX_DOCUMENT_CHARS=50000
MAX_QUESTION_CHARS=1000
RETRIEVAL_TOP_K=5
MAX_OUTPUT_TOKENS=800

# API
PORT=3001
WEB_ORIGIN=http://localhost:3000
# Swagger UI at /api/docs; set to false in production
API_DOCS_ENABLED=true
